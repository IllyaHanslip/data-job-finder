# Copy this file to .env and paste in your API keys.
# .env is listed in .gitignore, so your keys are never uploaded to GitHub.
# The program still works without keys, but then it only searches remote job boards.

# Adzuna: sign up at https://developer.adzuna.com/signup
# (25 free trial calls, then £8 a month: see README.md)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed (free): register at https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Anthropic (optional): only for Claude's entry-level check, see README.md. Get a key at
# https://console.anthropic.com; Anthropic charges for each advert checked.
ANTHROPIC_API_KEY=
